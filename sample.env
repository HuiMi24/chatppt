# This is a sample .env file for ChatPPT.
# Copy this file to .env and fill in your actual values.
# Lines starting with # are comments.

# --- OpenAI Configuration ---
# Your OpenAI API Key (required if using OpenAI provider and not set via UI)
# OPENAI_API_KEY="sk-..."

# Custom OpenAI API Base URL (optional, for proxies or OpenAI-compatible services)
# OPENAI_API_BASE="https://api.example.com/v1"

# --- Anthropic Configuration ---
# Your Anthropic API Key (required if using Anthropic provider and not set via UI)
# ANTHROPIC_API_KEY="sk-ant-..."

# --- Groq Configuration ---
# Your Groq API Key (required if using Groq provider and not set via UI)
# GROQ_API_KEY="gsk_..."

# Groq API Base URL (optional, defaults to https://api.groq.com/openai/v1 if not set in config.py or chatppt.py)
# GROQ_API_BASE="https://api.groq.com/openai/v1" 

# Default Groq Model Name (optional, used if Groq is selected and no model is specified in UI/CLI)
# Defaults to "mixtral-8x7b-32768" in the code if this is not set.
# GROQ_DEFAULT_MODEL="mixtral-8x7b-32768"

# --- Other Optional Configurations (Examples not yet fully implemented in config.py but good for future) ---
# Default Ollama Model Name
# OLLAMA_DEFAULT_MODEL="llama3"

# Default OpenAI Model Name
# OPENAI_DEFAULT_MODEL="gpt-3.5-turbo"

# Default Anthropic Model Name
# ANTHROPIC_DEFAULT_MODEL="claude-3-haiku-20240307"
